<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Chọn nhân vật</title>
<style>
:root{--bg:#eef1f5;--surface:#fff;--ink:#16202e;--muted:#5b6778;--line:#d5dbe4;--focus:#2f5d8a;color-scheme:light}
@media (prefers-color-scheme:dark){:root{--bg:#0f141b;--surface:#19212b;--ink:#e8edf3;--muted:#9aa7b8;--line:#2b3644;--focus:#8fb8e8;color-scheme:dark}}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
h1,h2,.name{font-family:Georgia,"Times New Roman",serif}
.wrap{max-width:1080px;margin:0 auto;padding:28px 18px 48px}
h1{font-size:clamp(1.8rem,4vw,2.6rem);margin:0;line-height:1.15}
header p{margin:6px 0 0;color:var(--muted)}
.layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:24px;margin-top:26px;align-items:start}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}

/* Thẻ nhân vật */
.tile{all:unset;box-sizing:border-box;cursor:pointer;display:flex;flex-direction:column;justify-content:flex-end;
  min-height:220px;padding:14px;border-radius:14px;background:var(--c);color:#fff;position:relative;overflow:hidden}
.tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.tile.has-img::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.7),transparent 60%)}
.tile .ph{position:absolute;top:10px;right:14px;font:700 3.5rem/1 Georgia,serif;opacity:.25}
.tile .name,.tile .role{position:relative;z-index:1}
.tile .name{font-size:1.15rem;font-weight:700;line-height:1.2}
.tile .role{font-size:.85rem;opacity:.9;margin-top:2px}
.tile:focus-visible,.btn:focus-visible,input:focus-visible,.intro-skip:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
.tile[aria-pressed="true"]{outline:3px solid var(--ink);outline-offset:3px}

/* Khung hồ sơ */
.detail{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:24px;position:sticky;top:16px}
.detail .pic{width:100%;max-height:360px;object-fit:cover;border-radius:12px;margin-bottom:16px;display:block}
.detail .bar{height:6px;border-radius:3px;background:var(--c);margin:0 0 14px;width:64px}
.detail h2{margin:0;font-size:1.9rem;line-height:1.15}
.detail .role{color:var(--muted);margin:2px 0 0}
.detail h3{margin:22px 0 6px;font-size:1rem}
.detail p{margin:0;max-width:62ch;white-space:pre-line}
.scene{border-left:4px solid var(--c);background:var(--bg);padding:12px 16px;border-radius:0 10px 10px 0;
  font-family:Georgia,serif;font-style:italic}
.empty{color:var(--muted)}
.linkrow{display:flex;gap:8px;flex-wrap:wrap}
.linkrow input{flex:1 1 220px;min-width:0;padding:10px 12px;border:1px solid var(--line);border-radius:10px;
  background:var(--bg);color:var(--ink);font:inherit;font-size:.9rem}
.btn{cursor:pointer;border:0;border-radius:10px;padding:10px 16px;font:inherit;font-weight:600;
  text-decoration:none;display:inline-flex;align-items:center}
.btn.main{background:var(--c);color:#fff}
.btn.alt{background:transparent;color:var(--ink);border:1px solid var(--line)}
.start{margin-top:14px}
.close{display:none;margin-bottom:14px}

@media (max-width:820px){
  .layout{display:block}
  .detail{display:none;position:fixed;inset:0;z-index:20;border-radius:0;border:0;overflow:auto;padding:20px 18px 28px}
  .detail.open{display:block}
  .close{display:inline-flex}
}

/* ===== MÀN HÌNH CHÉM TRÁI CÂY ===== */
#intro{position:fixed;inset:0;z-index:100;background:#10151d;color:#fff;transition:opacity .5s;
  touch-action:none;user-select:none;-webkit-user-select:none}
#intro.done{opacity:0;pointer-events:none}
#game{position:absolute;inset:0;width:100%;height:100%;display:block;touch-action:none;cursor:crosshair}
.intro-top{position:absolute;top:0;left:0;right:0;padding:calc(20px + env(safe-area-inset-top,0px)) 70px 0;
  text-align:center;pointer-events:none}
.intro-top strong{display:block;font:700 clamp(1.3rem,4vw,2rem)/1.2 Georgia,serif}
.intro-top span{display:block;margin-top:6px;color:#aab6c6;font-size:.95rem}
.intro-bottom{position:absolute;left:0;right:0;bottom:0;padding:0 24px calc(26px + env(safe-area-inset-bottom,0px));
  text-align:center;pointer-events:none}
.ld-bar{height:10px;border-radius:5px;background:rgba(255,255,255,.18);overflow:hidden;max-width:420px;margin:8px auto 0}
.ld-bar i{display:block;height:100%;width:0;background:#7bd389;transition:width .25s}
.intro-skip{position:absolute;top:calc(14px + env(safe-area-inset-top,0px));right:14px;z-index:2;cursor:pointer;
  background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.3);border-radius:999px;
  padding:8px 16px;font:inherit;font-size:.9rem}
</style>
</head>
<body>

<!-- Màn hình chém trái cây -->
<div id="intro" role="dialog" aria-label="Màn hình tải trang">
  <canvas id="game"></canvas>
  <button class="intro-skip" id="skip" type="button">Bỏ qua</button>
  <div class="intro-top">
    <strong>Chém trái cây để vào trang</strong>
    <span id="hint">Vuốt ngón tay hoặc kéo chuột qua trái cây</span>
  </div>
  <div class="intro-bottom">
    <div id="pct">Đang tải… 0%</div>
    <div class="ld-bar"><i id="fill"></i></div>
  </div>
</div>

<!-- Giao diện chính -->
<div class="wrap">
  <header>
    <h1>Chọn nhân vật</h1>
    <p>Nhấp vào một hồ sơ để xem tên, backstory, cảnh mở đầu và link nhân vật.</p>
  </header>
  <div class="layout">
    <div class="grid" id="grid"></div>
    <section class="detail" id="detail" aria-live="polite">
      <p class="empty">Chọn một nhân vật để xem hồ sơ.</p>
    </section>
  </div>
</div>

<script>
/* ============================================================
   ĐIỀN THÔNG TIN NHÂN VẬT Ở ĐÂY
   - name:      tên nhân vật
   - role:      mô tả ngắn
   - image:     đường dẫn ảnh, ví dụ "anh/nhanvat1.jpg" hoặc link https://...
   - color:     màu nền thẻ khi chưa có ảnh (mã hex)
   - backstory: tiểu sử
   - scene:     cảnh mở đầu
   - link:      link nhân vật
   ============================================================ */
var CHARACTERS = [
  { name: "", role: "", image: "", color: "#2f5d8a", backstory: "", scene: "", link: "" },
  { name: "", role: "", image: "", color: "#9c3d2e", backstory: "", scene: "", link: "" },
  { name: "", role: "", image: "", color: "#3d6b4f", backstory: "", scene: "", link: "" },
  { name: "", role: "", image: "", color: "#6a4a8c", backstory: "", scene: "", link: "" },
  { name: "", role: "", image: "", color: "#8a5a1c", backstory: "", scene: "", link: "" },
  { name: "", role: "", image: "", color: "#1f6f78", backstory: "", scene: "", link: "" }
];

/* ===== GIAO DIỆN CHÍNH ===== */
var grid = document.getElementById("grid");
var detail = document.getElementById("detail");
var current = -1;
var EMPTY = '<span class="empty">Chưa có thông tin</span>';

function isMobile(){ return window.matchMedia("(max-width:820px)").matches; }
function esc(s){
  return String(s).replace(/[&<>"]/g, function(c){
    return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c];
  });
}
function displayName(c, i){ return c.name || ("Nhân vật " + (i + 1)); }

CHARACTERS.forEach(function(c, i){
  var b = document.createElement("button");
  b.className = "tile" + (c.image ? " has-img" : "");
  b.type = "button";
  b.setAttribute("aria-pressed", "false");
  b.style.setProperty("--c", c.color);
  b.innerHTML =
    (c.image ? '<img src="' + esc(c.image) + '" alt="' + esc(displayName(c, i)) + '">'
             : '<span class="ph" aria-hidden="true">' + (i + 1) + '</span>') +
    '<span class="name">' + esc(displayName(c, i)) + '</span>' +
    (c.role ? '<span class="role">' + esc(c.role) + '</span>' : '');
  b.addEventListener("click", function(){ select(i); });
  grid.appendChild(b);
});

function select(i){
  var c = CHARACTERS[i];
  if(!c) return;
  current = i;
  Array.prototype.forEach.call(grid.children, function(t, k){
    t.setAttribute("aria-pressed", String(k === i));
  });
  var name = displayName(c, i);
  detail.style.setProperty("--c", c.color);
  detail.innerHTML =
    '<button class="btn alt close" type="button" id="close">Quay lại danh sách</button>' +
    (c.image ? '<img class="pic" src="' + esc(c.image) + '" alt="' + esc(name) + '">' : '') +
    '<div class="bar"></div>' +
    '<h2>' + esc(name) + '</h2>' +
    (c.role ? '<p class="role">' + esc(c.role) + '</p>' : '') +
    '<h3>Backstory</h3>' + (c.backstory ? '<p>' + esc(c.backstory) + '</p>' : '<p>' + EMPTY + '</p>') +
    '<h3>Cảnh mở đầu</h3>' + (c.scene ? '<p class="scene">' + esc(c.scene) + '</p>' : '<p>' + EMPTY + '</p>') +
    '<h3>Link nhân vật</h3>' +
    (c.link
      ? '<div class="linkrow"><input readonly value="' + esc(c.link) + '" aria-label="Link nhân vật">' +
        '<button class="btn alt" type="button" id="copy">Sao chép</button></div>' +
        '<div class="start"><a class="btn main" href="' + esc(c.link) + '" target="_blank" rel="noopener">Bắt đầu với ' + esc(name) + '</a></div>'
      : '<p>' + EMPTY + '</p>');

  document.getElementById("close").addEventListener("click", closeDetail);
  var copyBtn = document.getElementById("copy");
  if(copyBtn){
    copyBtn.addEventListener("click", function(){
      var inp = detail.querySelector("input");
      function done(){
        copyBtn.textContent = "Đã sao chép";
        setTimeout(function(){ copyBtn.textContent = "Sao chép"; }, 1500);
      }
      if(navigator.clipboard){
        navigator.clipboard.writeText(c.link).then(done, function(){ inp.select(); document.execCommand("copy"); done(); });
      } else { inp.select(); document.execCommand("copy"); done(); }
    });
  }
  if(isMobile()){ detail.classList.add("open"); detail.scrollTop = 0; }
}

function closeDetail(){
  detail.classList.remove("open");
  if(current > -1) grid.children[current].focus();
}

document.addEventListener("keydown", function(e){
  if(e.key === "Escape" && detail.classList.contains("open")) closeDetail();
});

if(!isMobile() && CHARACTERS.length) select(0);

/* ===== TRÒ CHÉM TRÁI CÂY ===== */
(function(){
  var TARGET = 8;            /* số quả cần chém để tải xong, sửa tùy ý */
  var intro = document.getElementById("intro");
  var cv = document.getElementById("game");
  var ctx = cv.getContext("2d");
  var fill = document.getElementById("fill");
  var pct = document.getElementById("pct");
  var hint = document.getElementById("hint");
  var skip = document.getElementById("skip");

  var TYPES = [
    {e:"🍉",c:"#e0394d"},{e:"🍊",c:"#f59a23"},{e:"🍎",c:"#d62b2b"},
    {e:"🍋",c:"#f2d21b"},{e:"🍇",c:"#7b4bb0"},{e:"🍍",c:"#f0c630"},{e:"🥝",c:"#7bb83d"}
  ];
  var W, H, G, R;
  var fruits = [], halves = [], parts = [], trail = [];
  var sliced = 0, finished = false, down = false, raf = 0, last = 0, spawnT = 0.3;

  document.body.style.overflow = "hidden";

  function resize(){
    var dpr = window.devicePixelRatio || 1;
    W = intro.clientWidth; H = intro.clientHeight;
    cv.width = W * dpr; cv.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    G = H * 1.6;
    R = Math.max(28, Math.min(48, Math.min(W, H) * 0.07));
  }
  resize();
  window.addEventListener("resize", resize);

  function spawn(){
    var n = 1 + (Math.random() < 0.4 ? 1 : 0) + (Math.random() < 0.15 ? 1 : 0);
    for(var i = 0; i < n; i++){
      var t = TYPES[Math.floor(Math.random() * TYPES.length)];
      var x = W * (0.2 + Math.random() * 0.6);
      var h = H * (0.5 + Math.random() * 0.25);
      fruits.push({
        x: x, y: H + R,
        vx: (W / 2 - x) * (0.2 + Math.random() * 0.4) + (Math.random() - 0.5) * 80,
        vy: -Math.sqrt(2 * G * h),
        rot: Math.random() * 6.28, vr: (Math.random() - 0.5) * 6,
        e: t.e, c: t.c
      });
    }
  }

  function sliceFruit(f, cut){
    sliced++;
    updateProgress();
    var nx = -Math.sin(cut), ny = Math.cos(cut);
    [-1, 1].forEach(function(side){
      halves.push({
        x: f.x, y: f.y, vx: f.vx * 0.5 + nx * side * 150, vy: f.vy * 0.5 + ny * side * 150 - 80,
        rot: f.rot, vr: f.vr + side * 2, cut: cut, side: side, e: f.e
      });
    });
    for(var i = 0; i < 12; i++){
      var a = Math.random() * 6.28, s = 80 + Math.random() * 220;
      parts.push({x: f.x, y: f.y, vx: Math.cos(a) * s, vy: Math.sin(a) * s - 60, life: 0.5, c: f.c});
    }
  }

  function updateProgress(){
    var p = Math.min(100, Math.round(sliced / TARGET * 100));
    fill.style.width = p + "%";
    pct.textContent = p >= 100 ? "Tải xong!" : "Đang tải… " + p + "%";
    if(p >= 100) finish();
  }

  function finish(){
    if(finished) return;
    finished = true;
    fill.style.width = "100%";
    pct.textContent = "Tải xong!";
    hint.textContent = "Chào mừng bạn";
    setTimeout(function(){
      intro.classList.add("done");
      document.body.style.overflow = "";
      setTimeout(function(){
        cancelAnimationFrame(raf);
        window.removeEventListener("resize", resize);
        intro.remove();
      }, 550);
    }, 500);
  }

  skip.addEventListener("click", finish);

  /* Điều khiển chuột / cảm ứng */
  function pos(e){
    var r = cv.getBoundingClientRect();
    return {x: e.clientX - r.left, y: e.clientY - r.top, t: performance.now()};
  }
  cv.addEventListener("pointerdown", function(e){
    down = true; cv.setPointerCapture(e.pointerId);
    trail = [pos(e)];
  });
  cv.addEventListener("pointermove", function(e){
    if(!down || finished) return;
    var p = pos(e), q = trail[trail.length - 1];
    trail.push(p);
    if(q) hitTest(q, p);
  });
  function up(){ down = false; }
  cv.addEventListener("pointerup", up);
  cv.addEventListener("pointercancel", up);

  function hitTest(a, b){
    var dx = b.x - a.x, dy = b.y - a.y, len2 = dx * dx + dy * dy;
    if(len2 < 4) return;
    var cut = Math.atan2(dy, dx);
    for(var i = fruits.length - 1; i >= 0; i--){
      var f = fruits[i];
      var t = Math.max(0, Math.min(1, ((f.x - a.x) * dx + (f.y - a.y) * dy) / len2));
      var cx = a.x + t * dx - f.x, cy = a.y + t * dy - f.y;
      if(cx * cx + cy * cy < R * R){
        fruits.splice(i, 1);
        sliceFruit(f, cut);
      }
    }
  }

  /* Vẽ và cập nhật */
  function drawEmoji(e){
    ctx.font = (R * 2) + "px 'Apple Color Emoji','Segoe UI Emoji','Noto Color Emoji',sans-serif";
    ctx.textAlign = "center"; ctx.textBaseline = "middle";
    ctx.fillText(e, 0, 0);
  }

  function frame(ts){
    if(!last) last = ts;
    var dt = Math.min((ts - last) / 1000, 0.033); last = ts;

    if(!finished){
      spawnT -= dt;
      if(spawnT <= 0){ spawn(); spawnT = 0.55 + Math.random() * 0.5; }
    }

    fruits.forEach(function(f){ f.vy += G * dt; f.x += f.vx * dt; f.y += f.vy * dt; f.rot += f.vr * dt; });
    fruits = fruits.filter(function(f){ return f.y < H + R * 2 || f.vy < 0; });
    halves.forEach(function(h){ h.vy += G * dt; h.x += h.vx * dt; h.y += h.vy * dt; h.rot += h.vr * dt; });
    halves = halves.filter(function(h){ return h.y < H + R * 3; });
    parts.forEach(function(p){ p.vy += G * 0.6 * dt; p.x += p.vx * dt; p.y += p.vy * dt; p.life -= dt; });
    parts = parts.filter(function(p){ return p.life > 0; });

    ctx.clearRect(0, 0, W, H);

    fruits.forEach(function(f){
      ctx.save(); ctx.translate(f.x, f.y); ctx.rotate(f.rot); drawEmoji(f.e); ctx.restore();
    });

    halves.forEach(function(h){
      var big = R * 3;
      ctx.save();
      ctx.translate(h.x, h.y);
      ctx.rotate(h.cut);
      ctx.beginPath();
      if(h.side < 0) ctx.rect(-big, -big, big * 2, big); else ctx.rect(-big, 0, big * 2, big);
      ctx.clip();
      ctx.rotate(h.rot - h.cut);
      drawEmoji(h.e);
      ctx.restore();
    });

    parts.forEach(function(p){
      ctx.globalAlpha = Math.max(0, p.life / 0.5);
      ctx.fillStyle = p.c;
      ctx.beginPath(); ctx.arc(p.x, p.y, 3.5, 0, 6.28); ctx.fill();
    });
    ctx.globalAlpha = 1;

    /* Vệt chém */
    var now = performance.now();
    trail = trail.filter(function(p){ return now - p.t < 180; });
    ctx.lineCap = "round";
    for(var i = 1; i < trail.length; i++){
      var a = 1 - (now - trail[i].t) / 180;
      ctx.strokeStyle = "rgba(255,255,255," + a.toFixed(2) + ")";
      ctx.lineWidth = 2 + 7 * a;
      ctx.beginPath();
      ctx.moveTo(trail[i - 1].x, trail[i - 1].y);
      ctx.lineTo(trail[i].x, trail[i].y);
      ctx.stroke();
    }

    raf = requestAnimationFrame(frame);
  }
  raf = requestAnimationFrame(frame);
})();
</script>
</body>
</html>
